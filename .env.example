# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# Session cookie 签名密钥；生产环境必须是长随机串
SESSION_SECRET="replace-with-a-long-random-string-min-32-chars"

# AI Provider（M1 阶段暂时用不到，占位）
AI_PROVIDER="mock"
MOCK_AI_FAIL="false"

# 演示模式：true 时关闭首次强制改密与登录锁定，不放宽授权
# 生产构建必须保持 false（构建脚本会拒绝 DEMO_MODE=true 的 prod build）
DEMO_MODE="true"
